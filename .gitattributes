# Research archive: preserve extracted/generated artifacts byte-for-byte.
# Binary resources, raw TextAssets, tool distributions and logs must not
# be modified by automatic line-ending conversion.
* -text

# Maintained research entry points use LF on every platform.
/.gitattributes text eol=lf
/.gitignore text eol=lf
/README.md text eol=lf
/scripts/** text=auto eol=lf
/gameplay/** text=auto eol=lf
/notes/** text=auto eol=lf
/indexes/*.json text eol=lf
/indexes/*.jsonl text eol=lf
/indexes/*.txt text eol=lf
/restored/code/gameplay-structures/*.cs text eol=lf
/HANDOFF.md text eol=lf
/requirements-research.txt text eol=lf

# Required large analysis artifacts. Store one canonical native binary.
/unpacked/apk/lib/arm64-v8a/libil2cpp.so filter=lfs diff=lfs merge=lfs -text
/restored/code/il2cpp/il2cpp.h filter=lfs diff=lfs merge=lfs -text
/restored/code/il2cpp/script.json filter=lfs diff=lfs merge=lfs -text
/restored/code/il2cpp/dump.cs filter=lfs diff=lfs merge=lfs -text
